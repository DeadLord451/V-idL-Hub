local function createSlider(parent, name, min, max, default, callback)
    local f = Instance.new("Frame", parent)
    f.Size = UDim2.new(1, -10, 0, 50)
    f.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
    f.BorderSizePixel = 0
